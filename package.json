{
  "name": "@pulsatehq/web-sdk",
  "version": "1.0.0",
  "type": "module",
  "private": false,
  "scripts": {
    "dev": "vite --open /demo/",
    "build": "tsc && vite build --mode stage",
    "build:prod": "tsc && vite build",
    "test:pw": "npx playwright test --config=test/playwright/playwright.config.ts",
    "test:pw:update": "npx playwright test --config=test/playwright/playwright.config.ts --update-snapshots",
    "test:pw:update:linux": "docker run --rm -v \"$(pwd):/work\" -w /work mcr.microsoft.com/playwright:v1.58.2-noble bash -c 'npm ci && npm run build && npx playwright test --config=test/playwright/playwright.config.ts --update-snapshots'",
    "build:npm": "vite build --config vite.npm.config.js && tsc -p tsconfig.build.json",
    "prepack": "npm run build:npm"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "serve": "^14.2.5",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  },
  "description": "Pulsate Web SDK: in-app notifications, feed and event tracking for websites.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PulsateHQ/pulsatehq-web-sdk.git"
  },
  "files": [
    "dist-npm"
  ],
  "main": "./dist-npm/index.js",
  "module": "./dist-npm/index.js",
  "types": "./dist-npm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-npm/index.d.ts",
      "default": "./dist-npm/index.js"
    },
    "./styles.css": "./dist-npm/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
